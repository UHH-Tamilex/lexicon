  <text xml:lang="en">
    <body>
      <entry corresp="paṉuval[TL]">
        <form xml:lang="ta">paṉuval</form>
        <gramGrp><gram>verbal noun</gram></gramGrp>
        <sense><def xml:lang="en">(not DEDR):  toused cotton</def>
<usg xml:lang="en">
</usg>
<cit source="https://uhh-tamilex.github.io/Narrinai/NA353.xml?id=NA353&amp;w=0,17">
    <q xml:lang="ta"><w>āḷ</w> <w>il</w> <w>peṇṭir</w> <w>tāḷiṉ</w> <w>ceyta</w> / <w>nuṇaṅku</w> <w>nuṇ</w> <w>paṉuval</w> <w>pōla<c type="geminated">k</c></w> <w>kaṇam</w> <w>koḷa</w> / <w><c type="glide">v</c>āṭu</w> <w>maḻai</w> <w>tavaḻum</w> <w>kōṭ<c type="elided">u</c></w> <w>uyar</w> <w>neṭu</w> <w>varai</w></q>
    <q xml:lang="en">the high tall mountain with peaks covered in playing clouds / in groups, resembling the finest cotton / that is made by the effort of manless women</q>
    <ref target="https://uhh-tamilex.github.io/Narrinai/NA353.xml?highlight=%5Bid%3DNA353%5D%20.l%3Anth-of-type(1)">NA353, lines 1–3</ref>
</cit>
<note xml:lang="en">See also <foreign xml:lang="ta-Latn">paṉṉal</foreign>.
</note></sense><sense><def xml:lang="en">musical/poetic composition
</def>
<usg xml:lang="en">
</usg>
<cit>
  <ref><expan ref="#AN"/> 345.6</ref>
  <q xml:lang="ta">nuṇaṅku nuṇ paṉuval pulavaṉ pāṭiya</q>
  <q xml:lang="en">which is sung by the poet in very subtle compositions</q>
</cit>
<cit>
  <ref><expan ref="#AN"/> 352.11ff.</ref>
  <q xml:lang="ta">kaṭum pari<c type="geminated">p</c> puravi neṭum tēr añci /
	nal <c type="geminated">l</c>icai niṟutta naya varum paṉuval /
	tol <c type="geminated">l</c>icai niṟīiya <c type="glide">v</c>urai cāl pāṇ makaṉ
</q>
  <q xml:lang="en">the bard worthy of [praising] words whose ancient fame is established /
	for the adorable compositions that established the fame /
	of Añci with a tall chariot [and] fast-moving horses
</q>
</cit>
<cit source="https://uhh-tamilex.github.io/NalayiratTivviyapPirapantam/PTM9.9.10.xml?id=PTM9.9.10&amp;w=18,23">
    <q xml:lang="ta"><w>pāṭal</w> <w>paṉuval</w> <w>pattum</w> <w>payilvārkk<c type="elided">u</c></w> <w>illai</w> <w>pāvaṅkaḷ-ē</w></q>
    <q xml:lang="en">For those who learn [this] composition of ten songs composed there will be no evils.</q>
    <ref target="https://uhh-tamilex.github.io/NalayiratTivviyapPirapantam/PTM9.9.10.xml?highlight=%5Bid%3DPTM9.9.10%5D%20.l%3Anth-of-type(4)"><title xml:lang="ta">Periya Tirumoḻi</title> <num>9.9.10</num>, line 4</ref>
</cit>
<note xml:lang="en">
</note></sense>
